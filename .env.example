# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit real credentials.
#
# See README.md for full local-development and production setup
# instructions, including how to create the matching local
# PostgreSQL role and database on macOS.

# --- Database (required, no default) --------------------------------
DB_NAME=school_scheduler_dev
DB_USER=school_scheduler
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Environment switch ----------------------------------------------
# "development" (default if unset) or "production". Controls the
# default for DEBUG/ALLOWED_HOSTS/SECURE_* below, and makes SECRET_KEY
# and ALLOWED_HOSTS required rather than defaulted. Leave unset or
# "development" for local work.
# DJANGO_ENV=development

# --- Required only when DJANGO_ENV=production ------------------------
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never commit the real value.
# SECRET_KEY=replace-with-a-real-random-secret-key

# Comma-separated list of hostnames this deployment is served as.
# ALLOWED_HOSTS=example.com,www.example.com

# --- Optional, any environment ----------------------------------------
# Comma-separated list, only needed once a real HTTPS domain exists
# (e.g. when forms submitted from https://example.com must be trusted
# by CSRF even if arriving through a proxy). Leave unset locally.
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Explicit overrides for the booleans config/settings.py otherwise
# derives from DJANGO_ENV (true/false/yes/no/on/off/1/0 — see README.md
# for what each defaults to and when you'd want to override it).
# DEBUG=false
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=3600

# Set to true ONLY if this deployment actually sits behind a reverse
# proxy/load balancer that terminates TLS and sets X-Forwarded-Proto.
# Enabling it otherwise lets a client spoof that header. Leave unset
# locally and on any setup without such a proxy.
# BEHIND_TLS_PROXY=true
